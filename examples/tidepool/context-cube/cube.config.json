{
  "preset": "balanced",
  "invariants": {
    "approval": "required"
  },
  "history": {
    "unit": "day",
    "gitCommits": 400
  },
  "update": {
    "trigger": "commit"
  },
  "agents": [
    "claude-code"
  ],
  "sources": [],
  "tokens": {
