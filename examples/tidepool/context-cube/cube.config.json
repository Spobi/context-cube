  },
  "limits": {
    "z0Words": 80,
    "rootDrawerTokens": 1500,
    "blockTokens": 3000,
    "links": 8
  },
  "ai": {
    "parallel": 4
  },
  "hooks": {
    "scope": "local"
  }
}
