{
  "step": "recipe",
  "tier": "sonnet",
  "output": {
    "version": 1,
    "sources": [
      {
        "path": "CLAUDE.md",
        "sections": [
          {
            "startLine": 1,
            "kind": "rules",
            "split": {
              "mode": "items"
            },
            "title": "Working here"
          },
          {
            "startLine": 8,
            "kind": "history",
            "split": {
              "mode": "heading",
              "level": 3
            },
            "key": "^###\\s+(\\d{4}-\\d{2}-\\d{2})",
            "date": "^###\\s+(\\d{4}-\\d{2}-\\d{2})",
            "summary": "^###\\s+\\d{4}-\\d{2}-\\d{2}\\s+—\\s+(.+)$",
            "order": "newest-first",
            "title": "Recent changes"
          },
          {
            "startLine": 14,
            "kind": "notes",
            "split": {
              "mode": "items"
            },
            "title": "Lessons"
          }
        ]
      }
    ],
    "refs": []
  }
}
